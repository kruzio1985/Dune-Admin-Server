                <div class="card">
                    <div class="card-header">🛠️ Progression</div>
                    <div class="card-body">
                        <div class="flex gap-2 flex-wrap">
                            <button class="btn btn-primary" onclick="GameplayTab.fillWater()">💧 Fill Water</button>
                            <button class="btn btn-primary" onclick="GameplayTab.repairGear()">🔧 Repair All Gear</button>
                            <button class="btn btn-danger" onclick="GameplayTab.cleanInventory()">🗑️ Clean Inventory</button>
                            <button class="btn btn-danger" onclick="GameplayTab.resetProgression()">🔄 Reset Progression</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-header">⭐ Specializations</div>
                <div class="card-body">
                    <div id="specStatus" class="mb-2">Loading...</div>
                    <div class="flex gap-2 flex-wrap">
                        <button class="btn btn-warning" onclick="GameplayTab.maxSpecializations()">⬆ Max All (lvl 100)</button>
                        <button class="btn btn-info" onclick="GameplayTab.grantAllKeystones()">💎 All Keystones (205)</button>
                        <select class="form-select" id="specTrack" style="width:130px">
                            <option value="Combat">⚔️ Combat</option>
                            <option value="Crafting">🔧 Crafting</option>
                            <option value="Exploration">🗺️ Exploration</option>
                            <option value="Gathering">🌿 Gathering</option>
                            <option value="Sabotage">🗡️ Sabotage</option>
                        </select>
                        <input type="number" class="form-input" id="specXP" value="5000" style="width:90px" placeholder="XP">
                        <button class="btn btn-sm btn-primary" onclick="GameplayTab.awardSpecXP()">+XP to Track</button>
                    </div>
                </div>
            </div>
        `;
        this.fls_id = document.getElementById('gpFls')?.value || '';
        this.loadPlayers();
        this.loadLandsraad();
        this.loadSpecs();
    },

    async loadPlayers() {
        try {
            const data = await api.get('/players?limit=20');
            const sel = document.getElementById('gpPlayerSelect');
            if (!sel) return;
            const players = data.players || [];
            sel.innerHTML = '<option value="">-- Select player --</option>' +
                players.map(p => `<option value="${p.fls_id||''}" data-account="${p.account_id||''}">${p.character_name||'Unknown'} (${p.fls_id||'?'})</option>`).join('');
            // Pre-select if current FLS matches
            const currentFls = document.getElementById('gpFls')?.value;
            if (currentFls) sel.value = currentFls;
        } catch(e) {}
    },

    selectPlayer() {
        const sel = document.getElementById('gpPlayerSelect');
        const fls = document.getElementById('gpFls');
        if (sel && fls) {
            fls.value = sel.value;
        }
    },

    async loadSpecs() {
        try {
            const data = await api.get('/gameplay/specializations/status?player_id=2');
            const el = document.getElementById('specStatus');
            if (!el) return;
            const bars = (data.tracks||[]).map(t => {
                const pct = Math.min(100, (t.xp_amount||0)/44182*100);
                const emoji = {Combat:'⚔️',Crafting:'🔧',Exploration:'🗺️',Gathering:'🌿',Sabotage:'🗡️'}[t.track_type]||'⭐';
                return `<div style="margin:2px 0"><strong>${emoji} ${t.track_type}</strong> Lvl ${t.level} (${(t.xp_amount||0).toLocaleString()} XP)
                <div style="background:#333;height:6px;border-radius:3px;margin-top:2px"><div style="background:#4caf50;height:6px;border-radius:3px;width:${pct}%"></div></div></div>`;
            }).join('');
            el.innerHTML = bars;
        } catch(e) {}
    },
    async awardSpecXP() {
        const track = document.getElementById('specTrack')?.value || 'Combat';
        const xp = parseInt(document.getElementById('specXP')?.value || '5000');
        try {
            const r = await api.post(`/gameplay/specializations/award-xp?track=${track}&amount=${xp}`);
            showToast(r.message || 'XP awarded!', 'success');
            this.loadSpecs();
        } catch(e) { showToast(e.message, 'error'); }
    },

    getFls() { return document.getElementById('gpFls')?.value || 'FC4D3B70DB35663'; },

    async giveSolaris(amount) {
        const btn = event.target;
        btn.disabled = true; btn.textContent = '...';
        try {
            const r = await fetch('/api/v1/gameplay/give-solari', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({fls_id: this.getFls(), amount})
            });
            const data = await r.json();
            showToast(data.message || `+${amount.toLocaleString()} Solaris!`, 'success');
        } catch(e) { showToast('Error: ' + e.message, 'error'); }
        btn.disabled = false; btn.textContent = `+${(amount/1e9).toFixed(0)}B Solaris`;
    },
    async giveScrip(amount) {
        const btn = event.target;
        btn.disabled = true; btn.textContent = '...';
        try {
            const r = await fetch('/api/v1/gameplay/give-scrip', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({fls_id: this.getFls(), amount})
            });
            const data = await r.json();
            showToast(data.message || `+${amount.toLocaleString()} Scrip!`, 'success');
        } catch(e) { showToast('Error: ' + e.message, 'error'); }
        btn.disabled = false; btn.textContent = `+${(amount/1e9).toFixed(0)}B Scrip`;
    },
    async awardIntel(amount) {
        try {
            await api.post('/gameplay/intel/award', {account_id: 1, amount});
            showToast(`+${amount} Intel awarded!`);
        } catch(e) { showToast(e.message, 'error'); }
    },
    async awardXP(cat, xp) {
        try {
            await api.post('/gameplay/award-xp', {fls_id: this.getFls(), category: cat, experience: xp});
            showToast(`+${xp} ${cat} XP sent!`);
        } catch(e) { showToast(e.message, 'error'); }
    },
    async setSkillPoints(pts) {
        try {
            await api.post('/gameplay/skills/set-points', {fls_id: this.getFls(), points: pts});
            showToast(`${pts} skill points set!`);
        } catch(e) { showToast(e.message, 'error'); }
    },
    async unlockAllClasses() {
        for (const c of ['Trooper','Mentat','Swordmaster','BeneGesserit','Planetologist','Fremen']) {
            try { await api.post('/players/cheat-script', {fls_id: this.getFls(), script_name: `Unlock${c}`}); } catch(e) {}
        }
        showToast('All 6 classes unlocking!');
    },
    async maxAllSkills() {
        const modules = ['Trooper','Mentat','Swordmaster','BeneGesserit','Planetologist','Fremen'].flatMap(c => [1,2,3].map(l => `Skills.Key.${c}${l}`));
        for (const m of modules) {
            try { await api.post('/gameplay/skills/set-module', {fls_id: this.getFls(), module: m, level: 3}); } catch(e) {}
        }
        showToast(`${modules.length} skills maxed!`);
    },
    async teleportToPlayer() {
        const target = document.getElementById('gpTarget')?.value;
        if (!target) return showToast('Enter target FLS ID', 'error');
        try { await api.post('/gameplay/teleport/to-player', {source_fls_id: this.getFls(), target_fls_id: target}); showToast(`Teleporting to ${target}!`); }
        catch(e) { showToast(e.message, 'error'); }
    },
    async broadcast() {
        const title = document.getElementById('gpTitle')?.value || 'Server';
        const body = document.getElementById('gpMsg')?.value || '';
        try { await api.post('/gameplay/chat/broadcast', {title, body, duration_sec: 15}); showToast('Broadcast sent!'); }
        catch(e) { showToast(e.message, 'error'); }
    },
    async loadLandsraad() {
        try {
            const data = await api.get('/gameplay/landsraad/overview');
            const el = document.getElementById('landsraadData');
            if (!el) return;
            const totalRewards = (data.houses||[]).reduce((s,h) => s + (h.goal_amount||0), 0);
            el.innerHTML = '<p><strong>' + data.count + ' Landsraad houses</strong> | Total: <strong>' + totalRewards.toLocaleString() + ' Scrip</strong></p>' +
                (data.houses||[]).slice(0,25).map(h => '<div class="stat-card"><div class="stat-value">' + (h.goal_amount||0).toLocaleString() + '</div><div class="stat-label">' + (h.house_name||'').replace('DA_House','') + '</div>' + (h.completed ? '<div style=\"color:#4caf50;font-size:10px\">✅</div>' : '') + '</div>').join('');
        } catch(e) {}
    },
    async spawnVehicleParts() {
        try {
            await api.post('/gameplay/repair-gear', {fls_id: this.getFls()});
            showToast('Gear repaired for ' + this.getFls());
        } catch(e) { showToast(e.message, 'error'); }
    },
    async cleanInventory() {
        try {
            await api.post('/gameplay/clean-inventory', {fls_id: this.getFls()});
            showToast('Inventory cleaned for ' + this.getFls());
        } catch(e) { showToast(e.message, 'error'); }
    },
    async resetProgression() {
        if (!confirm('Reset character progression? This cannot be undone!')) return;
        try {
            await api.post('/gameplay/journey/reset', {fls_id: this.getFls()});
            showToast('Progression reset for ' + this.getFls());
        } catch(e) { showToast(e.message, 'error'); }
    },
    async grantAllTech() {
        try {
            await api.post('/gameplay/grant-all-tech', {account_id: 1});
            showToast('All tech recipes granting!');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async completeAllQuests() {
        try {
            const r = await api.post('/gameplay/quests/complete-all');
            showToast(r.message || 'Quests completed!', 'success');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async grantAllKeystones() {
        try {
            const r = await api.post('/gameplay/keystones/grant-all?player_id=2');
            showToast(r.message || 'Keystones granted!', 'success');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async maxFactionRep() {
        try {
            const r = await api.post('/gameplay/faction/max-reputation?faction_id=2&player_id=2');
            showToast(r.message || 'Faction rep maxed!', 'success');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async playtestSetup() {
        try {
            await api.post('/players/cheat-script', {fls_id: this.getFls(), script_name: 'PlaytestSetupAdmin'});
            showToast('Full gear setup sent!');
        } catch(e) { showToast(e.message, 'error'); }
    }
    async loadLandsraad() {
        try {
            const data = await api.get('/gameplay/landsraad/overview');
            const el = document.getElementById('landsraadData');
            if (!el) return;
            const totalRewards = (data.houses||[]).reduce((s,h) => s + (h.goal_amount||0), 0);
            el.innerHTML = `<p><strong>${data.count} Landsraad houses</strong> | Total: <strong>${totalRewards.toLocaleString()} Scrip</strong></p>
                <p class="text-muted" style="font-size:10px">Dekrety i głosowanie — tylko w grze. Panel tylko uzupełnia punkty.</p>
                <div class="grid-3 mt-1">${(data.houses||[]).slice(0,25).map(h => 
                    `<div class="stat-card"><div class="stat-value">${(h.goal_amount||0).toLocaleString()}</div>
                    <div class="stat-label">${(h.house_name||'').replace('DA_House','')}</div>
                    ${h.completed ? '<div style="color:#4caf50;font-size:10px">✅</div>' : ''}</div>`
                ).join('')}</div>`;
        } catch(e) {}
    },
    async spawnVehicleParts() {
        const vtype = document.getElementById('gpVehicle')?.value;
        if (!vtype) return;
        try {
            const r = await api.post('/gameplay/vehicles/spawn-parts', {fls_id: this.getFls(), vehicle_type: vtype});
            showToast(r.message || 'Parts sent!', r.ok ? 'success' : 'error');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async autoCompleteMissions() {
        try {
            const faction = document.getElementById('gpFaction')?.value || '2';
            const r = await api.post(`/gameplay/landsraad/auto-complete?faction_id=${faction}`);
            showToast(r.message || 'Missions completed!', 'success');
            setTimeout(() => this.loadLandsraad(), 2000);
        } catch(e) { showToast(e.message, 'error'); }
    },
    async forceNewTerm() {
        if (!confirm('Create a NEW Landsraad term? This resets the board with 25 fresh tasks.')) return;
        try {
            const r = await api.post('/gameplay/landsraad/force-new-term');
            showToast(r.message, 'success');
            setTimeout(() => this.loadLandsraad(), 2000);
        } catch(e) { showToast(e.message, 'error'); }
    },
    async maxSpecializations() {
        try {
            const r = await api.post('/gameplay/specializations/max');
            showToast(r.message || 'Specializations maxed!', 'success');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async grantAllTech() {
        try {
            await api.post('/gameplay/grant-all-tech', {account_id: 1});
            showToast('All tech recipes granting!');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async completeAllQuests() {
        try {
            const r = await api.post('/gameplay/quests/complete-all');
            showToast(r.message || 'Quests completed!', 'success');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async grantAllKeystones() {
        try {
            const r = await api.post('/gameplay/keystones/grant-all?player_id=2');
            showToast(r.message || 'Keystones granted!', 'success');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async maxFactionRep() {
        try {
            const r = await api.post('/gameplay/faction/max-reputation?faction_id=2&player_id=2');
            showToast(r.message || 'Faction rep maxed!', 'success');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async giveItemLive() {
        const template = document.getElementById('gpItem')?.value;
        const qty = parseInt(document.getElementById('gpQty')?.value || '1000');
        if (!template) return showToast('Select item', 'error');
        try {
            const r = await fetch('/api/v1/gameplay/give-item-live', {
                method: 'POST', headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({fls_id: this.getFls(), template, qty, durability: 1.0})
            });
            const data = await r.json();
            showToast(`${data.message || 'Sent!'}`, 'success');
        } catch(e) { showToast('Error: ' + e.message, 'error'); }
    },
    async giveWelcomePack(kit = 'starter') {
        const fls = this.getFls();
        if (!fls) return showToast('Select a player first!', 'error');
        try {
            const r = await fetch(`/api/v1/gameplay/welcome/give-starter-kit?fls_id=${fls}&kit=${kit}`, { method: 'POST' });
            const data = await r.json();
            showToast(data.message || 'Kit sent!', 'success');
        } catch(e) { showToast('Error: ' + e.message, 'error'); }
    },
    async playtestSetup() {
        try {
            await api.post('/players/cheat-script', {fls_id: this.getFls(), script_name: 'PlaytestSetupAdmin'});
            showToast('Full gear setup sent!');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async fillWater() {
        try {
            await api.post('/gameplay/fill-water', {fls_id: this.getFls()});
            showToast('Water filled!');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async repairGear() {
        try {
            await api.post('/gameplay/repair-gear', {fls_id: this.getFls()});
            showToast('Gear repaired!');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async cleanInventory() {
        if (!confirm('Delete ALL inventory items?')) return;
        try {
            await api.post('/gameplay/clean-inventory', {fls_id: this.getFls()});
            showToast('Inventory cleaned!');
        } catch(e) { showToast(e.message, 'error'); }
    },
    async resetProgression() {
        if (!confirm('Reset ALL progression? CANNOT BE UNDONE!')) return;
        try {
            await api.post('/gameplay/reset-progression', {fls_id: this.getFls()});
            showToast('Progression reset!');
        } catch(e) { showToast(e.message, 'error'); }
    },
};
